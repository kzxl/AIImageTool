<UserControl x:Class="ImageTool.Host.Workspace.BatchQueuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1A1A1A" Foreground="#DDD">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#252526" Padding="10,8">
            <DockPanel>
                <TextBlock Text="BATCH QUEUE" FontSize="11" FontWeight="SemiBold" Foreground="#888" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Parallel:" Foreground="#888" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="cmbParallel" Width="42" Height="20" SelectedIndex="0" SelectionChanged="CmbParallel_SelectionChanged">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="6"/>
                        <ComboBoxItem Content="8"/>
                    </ComboBox>
                    <Button x:Name="btnPause" Content="⏸" Width="22" Height="22" Margin="6,0,2,0"
                            Background="#2D2D30" Foreground="#DDD" BorderThickness="0"
                            Cursor="Hand" Click="BtnPauseResume_Click" ToolTip="Pause/Resume"/>
                    <Button x:Name="btnClear" Content="✕" Width="22" Height="22" Margin="2,0"
                            Background="#2D2D30" Foreground="#DDD" BorderThickness="0"
                            Cursor="Hand" Click="BtnClear_Click" ToolTip="Clear completed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icJobs">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="6,4" Margin="0,1" Background="#202020" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}" Width="14" FontSize="11"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="↺" Width="18" Height="18" Margin="2,0" Background="Transparent" Foreground="#888" BorderThickness="0" Cursor="Hand"
                                                Tag="{Binding Id}" Click="BtnRetry_Click" ToolTip="Retry"/>
                                        <Button Content="✕" Width="18" Height="18" Margin="2,0" Background="Transparent" Foreground="#888" BorderThickness="0" Cursor="Hand"
                                                Tag="{Binding Id}" Click="BtnRemove_Click" ToolTip="Cancel/Remove"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="#DDD" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <Grid Grid.Row="1" Margin="14,2,0,0">
                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="3" Foreground="#55C1E7" Background="#2A2A2A" BorderThickness="0"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="#666" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
