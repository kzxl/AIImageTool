<UserControl x:Class="ImageTool.Host.Workspace.ExportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanelAltBrush}" Padding="10,8">
            <TextBlock Text="EXPORT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <TextBlock Text="Preset" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,10">
                    <Button x:Name="btnSavePreset" DockPanel.Dock="Right" Content="＋" Width="24" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Click="BtnSavePreset_Click" ToolTip="Lưu thiết lập hiện tại thành preset"/>
                    <Button x:Name="btnDeletePreset" DockPanel.Dock="Right" Content="✕" Width="24" Margin="0,0,4,0" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Click="BtnDeletePreset_Click" ToolTip="Xoá preset đang chọn"/>
                    <ComboBox x:Name="cmbPreset" Height="22" SelectionChanged="CmbPreset_SelectionChanged" ToolTip="Áp preset đã lưu"/>
                </DockPanel>

                <TextBlock Text="Format" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbFormat" Height="22" SelectedIndex="0" Margin="0,0,0,8">
                    <ComboBoxItem Content="PNG (lossless)" Tag="png"/>
                    <ComboBoxItem Content="JPEG" Tag="jpg"/>
                    <ComboBoxItem Content="WEBP" Tag="webp"/>
                    <ComboBoxItem Content="TIFF" Tag="tiff"/>
                </ComboBox>

                <TextBlock Text="Quality" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding Value, ElementName=slQuality, StringFormat={}{0:F0}}"
                               DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" Width="30"/>
                    <Slider x:Name="slQuality" Minimum="40" Maximum="100" Value="90"/>
                </DockPanel>

                <TextBlock Text="Max Long Edge (px, 0 = giữ nguyên)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="txtMaxLong" Text="0" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2" Height="22" Margin="0,0,0,8"/>

                <TextBlock Text="Xuất đa kích thước (tick = thêm bản, kèm hậu tố tên)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <WrapPanel Margin="0,0,0,8">
                    <CheckBox x:Name="chkSize2048" Content="2048" Tag="2048" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,10,0"/>
                    <CheckBox x:Name="chkSize1024" Content="1024" Tag="1024" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,10,0"/>
                    <CheckBox x:Name="chkSize512" Content="512" Tag="512" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,10,0"/>
                    <CheckBox x:Name="chkSize256" Content="256" Tag="256" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                </WrapPanel>

                <TextBlock Text="Output Sharpening" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbSharpen" Height="22" SelectedIndex="0" Margin="0,0,0,8">
                    <ComboBoxItem Content="None" Tag="none"/>
                    <ComboBoxItem Content="Screen (web/màn hình)" Tag="screen"/>
                    <ComboBoxItem Content="Print Low (giấy thường)" Tag="low"/>
                    <ComboBoxItem Content="Print High (matte/HiRes)" Tag="high"/>
                </ComboBox>

                <TextBlock Text="Output Folder" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="btnBrowse" DockPanel.Dock="Right" Content="..." Width="30" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Click="BtnBrowse_Click"/>
                    <TextBox x:Name="txtOutDir" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2" Height="22"/>
                </DockPanel>

                <TextBlock Text="Filename Pattern" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="txtPattern" Text="{}{name}_export.{ext}" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2" Height="22" Margin="0,0,0,8"/>
                <TextBlock Text="Tokens: {name} {ext} {w} {h} {n:000} {date} {date:yyyyMMdd} {parent}" FontSize="9" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                <CheckBox x:Name="chkCopyExif" Content="Giữ EXIF gốc (camera/lens/ngày/GPS)" IsChecked="True"
                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,0,12"/>

                <Button x:Name="btnExportSelection" Content="Export Selection" Height="32" Background="{DynamicResource SuccessBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnExportSelection_Click"/>
                <TextBlock x:Name="txtEstSize" Text="" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"/>
                <Button x:Name="btnContactSheet" Content="Contact Sheet…" Height="28" Margin="0,8,0,0" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Click="BtnContactSheet_Click" ToolTip="Ghép ảnh đang chọn thành 1 file lưới (contact sheet)"/>
                <TextBlock x:Name="txtHint" Text="Chọn ảnh trong browser rồi bấm Export." FontSize="10" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
