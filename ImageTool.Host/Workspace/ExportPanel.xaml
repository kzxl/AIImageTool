<UserControl x:Class="ImageTool.Host.Workspace.ExportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1A1A1A" Foreground="#DDD">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#252526" Padding="10,8">
            <TextBlock Text="EXPORT" FontSize="11" FontWeight="SemiBold" Foreground="#888"/>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <TextBlock Text="Format" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbFormat" Height="22" SelectedIndex="0" Margin="0,0,0,8">
                    <ComboBoxItem Content="PNG (lossless)" Tag="png"/>
                    <ComboBoxItem Content="JPEG" Tag="jpg"/>
                    <ComboBoxItem Content="WEBP" Tag="webp"/>
                </ComboBox>

                <TextBlock Text="Quality" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding Value, ElementName=slQuality, StringFormat={}{0:F0}}"
                               DockPanel.Dock="Right" Foreground="#55C1E7" Width="30"/>
                    <Slider x:Name="slQuality" Minimum="40" Maximum="100" Value="90"/>
                </DockPanel>

                <TextBlock Text="Max Long Edge (px, 0 = giữ nguyên)" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                <TextBox x:Name="txtMaxLong" Text="0" Background="#2A2A2A" Foreground="#DDD" BorderThickness="0" Padding="4,2" Height="22" Margin="0,0,0,8"/>

                <TextBlock Text="Output Sharpening" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbSharpen" Height="22" SelectedIndex="0" Margin="0,0,0,8">
                    <ComboBoxItem Content="None" Tag="none"/>
                    <ComboBoxItem Content="Screen (web/màn hình)" Tag="screen"/>
                    <ComboBoxItem Content="Print Low (giấy thường)" Tag="low"/>
                    <ComboBoxItem Content="Print High (matte/HiRes)" Tag="high"/>
                </ComboBox>

                <TextBlock Text="Output Folder" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="btnBrowse" DockPanel.Dock="Right" Content="..." Width="30" Background="#2D2D30" Foreground="#DDD" BorderThickness="0" Cursor="Hand" Click="BtnBrowse_Click"/>
                    <TextBox x:Name="txtOutDir" Background="#2A2A2A" Foreground="#DDD" BorderThickness="0" Padding="4,2" Height="22"/>
                </DockPanel>

                <TextBlock Text="Filename Pattern" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                <TextBox x:Name="txtPattern" Text="{}{name}_export.{ext}" Background="#2A2A2A" Foreground="#DDD" BorderThickness="0" Padding="4,2" Height="22" Margin="0,0,0,8"/>
                <TextBlock Text="Tokens: {name} {ext} {w} {h} {id}" FontSize="9" Foreground="#666" Margin="0,0,0,12"/>

                <Button x:Name="btnExportSelection" Content="Export Selection" Height="32" Background="#1E6E43" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnExportSelection_Click"/>
                <TextBlock x:Name="txtHint" Text="Chọn ảnh trong browser rồi bấm Export." FontSize="10" Foreground="#666" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
