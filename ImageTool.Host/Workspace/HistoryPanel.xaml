<UserControl x:Class="ImageTool.Host.Workspace.HistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1A1A1A" Foreground="#DDD">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#252526" Padding="10,8">
            <DockPanel>
                <TextBlock Text="HISTORY" FontSize="11" FontWeight="SemiBold" Foreground="#888"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnUndo" Content="↶" Width="22" Height="22" Margin="2,0"
                            Background="#2D2D30" Foreground="#DDD" BorderThickness="0"
                            Cursor="Hand" Click="BtnUndo_Click" ToolTip="Undo (Ctrl+Z)"/>
                    <Button x:Name="btnRedo" Content="↷" Width="22" Height="22" Margin="2,0"
                            Background="#2D2D30" Foreground="#DDD" BorderThickness="0"
                            Cursor="Hand" Click="BtnRedo_Click" ToolTip="Redo (Ctrl+Y)"/>
                    <Button x:Name="btnClear" Content="✕" Width="22" Height="22" Margin="2,0"
                            Background="#2D2D30" Foreground="#DDD" BorderThickness="0"
                            Cursor="Hand" Click="BtnClear_Click" ToolTip="Clear all"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icHistory">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,4" Margin="0,1" Cursor="Hand"
                                MouseLeftButtonUp="HistoryItem_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Background" Value="#2D2D30"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Marker}" FontSize="11"
                                           Foreground="{Binding MarkerBrush}" Width="14"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeShort}"
                                           FontSize="9" Foreground="#666"/>
                                <TextBlock Text="{Binding Title}" FontSize="11"
                                           Foreground="{Binding TextBrush}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
