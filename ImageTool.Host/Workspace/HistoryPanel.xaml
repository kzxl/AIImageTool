<UserControl x:Class="ImageTool.Host.Workspace.HistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanelAltBrush}" Padding="10,8">
            <DockPanel>
                <TextBlock Text="HISTORY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnUndo" Content="↶" Width="22" Height="22" Margin="2,0"
                            Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                            Cursor="Hand" Click="BtnUndo_Click" ToolTip="Undo (Ctrl+Z)"/>
                    <Button x:Name="btnRedo" Content="↷" Width="22" Height="22" Margin="2,0"
                            Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                            Cursor="Hand" Click="BtnRedo_Click" ToolTip="Redo (Ctrl+Y)"/>
                    <Button x:Name="btnClear" Content="✕" Width="22" Height="22" Margin="2,0"
                            Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                            Cursor="Hand" Click="BtnClear_Click" ToolTip="Clear all"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Snapshots (mốc edit có tên) -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgBaseBrush}" BorderBrush="{DynamicResource BorderBrush_}" BorderThickness="0,1,0,0">
            <DockPanel MaxHeight="200">
                <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanelAltBrush}" Padding="10,6">
                    <DockPanel>
                        <TextBlock Text="SNAPSHOTS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="btnAddSnapshot" DockPanel.Dock="Right" Content="+ Lưu" Height="22"
                                Padding="8,2" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                                Cursor="Hand" Click="BtnAddSnapshot_Click" HorizontalAlignment="Right"
                                ToolTip="Lưu trạng thái edit hiện tại thành snapshot có tên"/>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="icSnapshots">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,4" Margin="0,1" Cursor="Hand" Background="Transparent"
                                        MouseLeftButtonUp="Snapshot_Click">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" Width="18" Height="18"
                                                Background="Transparent" Foreground="{DynamicResource TextDimBrush}" BorderThickness="0"
                                                Cursor="Hand" Tag="{Binding Name}" Click="DeleteSnapshot_Click"
                                                ToolTip="Xoá snapshot"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeShort}" FontSize="9"
                                                   Foreground="{DynamicResource TextDimBrush}" Margin="4,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="Click để áp snapshot này"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="icHistory">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,4" Margin="0,1" Cursor="Hand"
                                    MouseLeftButtonUp="HistoryItem_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Marker}" FontSize="11"
                                           Foreground="{Binding MarkerBrush}" Width="14"/>
                                <Border DockPanel.Dock="Left" Width="44" Height="33" Margin="0,0,6,0"
                                        Background="{DynamicResource BgInputBrush}" CornerRadius="2">
                                    <Image Source="{Binding Thumb}" Stretch="Uniform"/>
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeShort}"
                                           FontSize="9" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" FontSize="11"
                                           Foreground="{Binding TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Chưa có chỉnh sửa nào.&#x0a;Chọn ảnh và kéo slider để bắt đầu."
                           FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasItems, ElementName=icHistory, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
