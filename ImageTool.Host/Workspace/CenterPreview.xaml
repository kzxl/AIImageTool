<UserControl x:Class="ImageTool.Host.Workspace.CenterPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#141414" Foreground="#DDD" Focusable="True"
             KeyDown="UserControl_KeyDown" KeyUp="UserControl_KeyUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Mode bar -->
        <Border Grid.Row="0" Background="#1E1E1E" Padding="10,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="btnModeSingle" Content="◰  Single (E)" Padding="10,4" Margin="0,0,4,0"
                            Background="#2D2D30" Foreground="#DDD" BorderThickness="0" Cursor="Hand"
                            Click="BtnModeSingle_Click"/>
                    <Button x:Name="btnModeGrid" Content="▦  Grid (G)" Padding="10,4" Margin="0,0,4,0"
                            Background="#2D2D30" Foreground="#DDD" BorderThickness="0" Cursor="Hand"
                            Click="BtnModeGrid_Click"/>
                    <Button x:Name="btnModeCull" Content="❐  Cull (C)" Padding="10,4" Margin="0,0,4,0"
                            Background="#2D2D30" Foreground="#DDD" BorderThickness="0" Cursor="Hand"
                            Click="BtnModeCull_Click"/>
                    <Button x:Name="btnModeFull" Content="⛶  Full (F)" Padding="10,4" Margin="0,0,4,0"
                            Background="#2D2D30" Foreground="#DDD" BorderThickness="0" Cursor="Hand"
                            Click="BtnModeFull_Click"/>
                    <Button x:Name="btnCrop" Content="◳  Crop (R)" Padding="10,4" Margin="12,0,4,0"
                            Background="#2D2D30" Foreground="#DDD" BorderThickness="0" Cursor="Hand"
                            Click="BtnCrop_Click" ToolTip="Bật/tắt cắt ảnh (kéo khung)"/>
                    <Button x:Name="btnCompare" Content="◫  Before/After (Y)" Padding="10,4" Margin="4,0,4,0"
                            Background="#2D2D30" Foreground="#DDD" BorderThickness="0" Cursor="Hand"
                            Click="BtnCompare_Click" ToolTip="So sánh ảnh gốc và ảnh đã chỉnh cạnh nhau"/>
                    <Button x:Name="btnStack" Content="⧉  Stack" Padding="10,4" Margin="4,0,4,0"
                            Background="#2D2D30" Foreground="#DDD" BorderThickness="0" Cursor="Hand"
                            Click="BtnStack_Click" ToolTip="Gom ảnh chụp liên tiếp (burst/bracket) thành nhóm trong Grid"/>
                    <ComboBox x:Name="cmbCropRatio" Width="110" Margin="4,0,0,0" Visibility="Collapsed"
                              VerticalAlignment="Center" SelectionChanged="CmbCropRatio_SelectionChanged"
                              ToolTip="Tỉ lệ khung cắt"/>
                </StackPanel>
                <TextBlock x:Name="txtFile" DockPanel.Dock="Left" Text="(chưa chọn ảnh)" Foreground="#AAA"
                           FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBlock x:Name="txtMeta" DockPanel.Dock="Right" HorizontalAlignment="Right"
                           Foreground="#666" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Mode containers -->
        <Grid Grid.Row="1" Background="#141414">
            <!-- SINGLE mode -->
            <Grid x:Name="paneSingle" Visibility="Visible" ClipToBounds="True"
                  Background="#01000000"
                  MouseLeftButtonDown="PaneSingle_MouseDown"
                  MouseMove="PaneSingle_MouseMove"
                  MouseLeftButtonUp="PaneSingle_MouseUp"
                  MouseWheel="PaneSingle_MouseWheel"
                  MouseRightButtonDown="PaneSingle_PanStart"
                  MouseRightButtonUp="PaneSingle_PanEnd">
                <TextBlock x:Name="txtPlaceholder"
                           Text="Chọn ảnh ở Browser hoặc bấm 📁  Open Folder"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#555" FontSize="16"/>
                <Image x:Name="imgPreview" Stretch="Uniform" Margin="20" RenderTransformOrigin="0,0">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="zoomScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="zoomPan" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Image x:Name="imgClip" Stretch="Uniform" Margin="20" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0,0">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="zoomScaleClip" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="zoomPanClip" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Image x:Name="imgAfter" Stretch="Uniform" Margin="20" Visibility="Collapsed" RenderTransformOrigin="0,0">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="zoomScaleAfter" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="zoomPanAfter" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Border x:Name="borderSplitLine" Width="2" Background="White"
                        HorizontalAlignment="Left" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="0" Opacity="0.5"/>
                    </Border.Effect>
                </Border>
                <Border x:Name="zoomBadge" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="30,30,0,0" Background="#AA000000" CornerRadius="2" Padding="6,2"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="txtZoom" Text="100%" Foreground="#DDD" FontSize="10"/>
                </Border>
                <Border x:Name="afterBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,30,30,0" Background="#CC55C1E7" CornerRadius="2" Padding="6,2"
                        Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock Text="AFTER · kéo để so sánh" Foreground="#000" FontSize="10" FontWeight="SemiBold"/>
                        <Button x:Name="btnClearAfter" Content="✕" Margin="6,0,0,0" Padding="2,0"
                                Background="Transparent" Foreground="#000" BorderThickness="0"
                                Click="BtnClearAfter_Click"/>
                    </DockPanel>
                </Border>

                <!-- Crop overlay: vẽ khung cắt + 8 tay nắm. Ẩn cho tới khi bật crop mode. -->
                <Canvas x:Name="cropOverlay" Background="#01000000" Visibility="Collapsed"
                        MouseLeftButtonDown="CropOverlay_MouseDown"
                        MouseMove="CropOverlay_MouseMove"
                        MouseLeftButtonUp="CropOverlay_MouseUp"/>

                <!-- Brush overlay: bắt nét vẽ cho local brush mask. Ẩn cho tới khi chọn brush mask. -->
                <Canvas x:Name="brushOverlay" Background="#01000000" Visibility="Collapsed" Cursor="Cross"
                        MouseLeftButtonDown="BrushOverlay_MouseDown"
                        MouseMove="BrushOverlay_MouseMove"
                        MouseLeftButtonUp="BrushOverlay_MouseUp"/>
            </Grid>

            <!-- GRID mode -->
            <ScrollViewer x:Name="paneGrid" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Height="220" Margin="6" Background="#1E1E1E"
                                    BorderThickness="2" CornerRadius="3" Cursor="Hand"
                                    MouseLeftButtonUp="GridItem_MouseLeftButtonUp"
                                    MouseRightButtonUp="GridItem_MouseRightButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="#FFD24E"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#55C1E7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="3"/>
                                    <Border Width="10" Height="10" CornerRadius="5"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                            Background="{Binding LabelBrush}"/>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                            Background="#CC55C1E7" CornerRadius="2" Padding="3,1"
                                            Visibility="{Binding IsEdited, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Đã chỉnh sửa">
                                        <TextBlock Text="✎" Foreground="#000" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6,6,6,26"
                                            Background="#CC222222" CornerRadius="3" Padding="5,1"
                                            Visibility="{Binding IsStackCover, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Nhóm ảnh chụp liên tiếp">
                                        <TextBlock Text="{Binding StackBadge}" Foreground="#FFD24E" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <Border VerticalAlignment="Bottom" Background="#AA000000" Padding="4,2">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RatingDisplay}"
                                                       Foreground="#FFD24E" FontSize="10"/>
                                            <TextBlock Text="{Binding FileName}" Foreground="#DDD" FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- CULL mode (compare 2-4 selected) -->
            <UniformGrid x:Name="paneCull" Visibility="Collapsed" Background="#141414"/>

            <!-- FULL mode (no margin) -->
            <Grid x:Name="paneFull" Visibility="Collapsed" Background="#000">
                <Image x:Name="imgFull" Stretch="Uniform"/>
            </Grid>

            <!-- COMPARE mode (side-by-side before/after) -->
            <Grid x:Name="paneCompare" Visibility="Collapsed" Background="#141414"
                  MouseWheel="PaneCompare_MouseWheel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="8" ClipToBounds="True">
                    <Image x:Name="imgCompareBefore" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="cmpScaleBefore" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="cmpPanBefore" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6"
                            Background="#AA000000" CornerRadius="2" Padding="6,2">
                        <TextBlock Text="BEFORE" Foreground="#DDD" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
                <Grid Grid.Column="1" Margin="8" ClipToBounds="True">
                    <Image x:Name="imgCompareAfter" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="cmpScaleAfter" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="cmpPanAfter" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6"
                            Background="#CC55C1E7" CornerRadius="2" Padding="6,2">
                        <TextBlock Text="AFTER" Foreground="#000" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
                <Border Width="1" Background="#333" HorizontalAlignment="Center"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#1E1E1E" Padding="8,4">
            <TextBlock x:Name="txtSelection" Text="Selection: 0" Foreground="#888" FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
