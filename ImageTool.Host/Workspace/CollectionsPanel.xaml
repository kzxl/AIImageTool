<UserControl x:Class="ImageTool.Host.Workspace.CollectionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgPanelBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgPanelAltBrush}" Padding="10,6">
            <DockPanel>
                <Button x:Name="btnAddCollection" DockPanel.Dock="Right" Content="+" Width="22" Height="22"
                        Background="{DynamicResource BorderBrush_}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="14"
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                        Click="BtnAddCollection_Click" ToolTip="New Collection"/>
                <TextBlock Text="COLLECTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ListBox x:Name="lstCollections" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"
                 SelectionChanged="LstCollections_SelectionChanged">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Rename" Click="MenuRename_Click"/>
                    <MenuItem Header="Delete" Click="MenuDelete_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="4,2">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ImageCount}"
                                   Foreground="{DynamicResource TextDimBrush}" FontSize="10" VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Background="{DynamicResource BgPanelAltBrush}" Padding="10,6">
            <DockPanel>
                <Button x:Name="btnAddSmart" DockPanel.Dock="Right" Content="+" Width="22" Height="22"
                        Background="{DynamicResource BorderBrush_}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="14"
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                        Click="BtnAddSmart_Click" ToolTip="New Smart Collection (rule-based)"/>
                <TextBlock Text="SMART COLLECTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ListBox x:Name="lstSmart" Grid.Row="3" Background="Transparent" BorderThickness="0"
                 Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" MaxHeight="200"
                 SelectionChanged="LstSmart_SelectionChanged">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Edit Rules" Click="MenuSmartEdit_Click"/>
                    <MenuItem Header="Delete" Click="MenuSmartDelete_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="4,2">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ImageCount}"
                                   Foreground="{DynamicResource TextDimBrush}" FontSize="10" VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                        <TextBlock Text="⚙" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
