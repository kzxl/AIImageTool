<UserControl x:Class="ImageTool.Host.Workspace.InfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1A1A1A" Foreground="#DDD">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#252526" Padding="10,8">
            <TextBlock Text="INFO" FontSize="11" FontWeight="SemiBold" Foreground="#888"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
            <StackPanel>
                <!-- Histogram -->
                <Border Background="#0F0F0F" Margin="6" Height="120">
                    <Grid>
                        <Image x:Name="imgHistogram" Stretch="Fill"/>
                        <TextBlock x:Name="txtHistEmpty" Text="(histogram)" Foreground="#444" FontSize="10"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Dòng tóm tắt thông số chụp -->
                <TextBlock x:Name="txtCaptureSummary" Margin="10,0,10,4" FontSize="11" Foreground="#BBB"
                           TextWrapping="Wrap" Visibility="Collapsed"/>

                <!-- Bảng màu chủ đạo (K-Means) -->
                <Border Background="#252526" Padding="10,4" Margin="0,2,0,0">
                    <TextBlock Text="MÀU CHỦ ĐẠO" FontSize="10" FontWeight="SemiBold" Foreground="#888"/>
                </Border>
                <ItemsControl x:Name="icColors" Margin="6,4,6,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" CornerRadius="3" Cursor="Hand" ToolTip="Click để copy mã màu"
                                    MouseLeftButtonUp="ColorSwatch_Click" Tag="{Binding Hex}">
                                <StackPanel>
                                    <Border Width="42" Height="30" CornerRadius="3" Background="{Binding Brush}"/>
                                    <TextBlock Text="{Binding Hex}" FontSize="8" Foreground="#AAA" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding PercentText}" FontSize="8" Foreground="#88C0D0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- EXIF header + map -->
                <Border Background="#252526" Padding="10,4">
                    <DockPanel>
                        <Button x:Name="btnMap" DockPanel.Dock="Right" Content="🗺 Bản đồ" Visibility="Collapsed"
                                Padding="6,1" FontSize="10" Background="#2D2D30" Foreground="#55C1E7"
                                BorderThickness="0" Cursor="Hand" Click="BtnMap_Click"
                                ToolTip="Mở vị trí GPS trên Google Maps"/>
                        <TextBlock Text="EXIF" FontSize="10" FontWeight="SemiBold" Foreground="#888" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <ItemsControl x:Name="icExif" Margin="6,4,6,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="#888" FontSize="10"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#DDD" FontSize="10"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Sửa metadata (gộp từ MetaEditor) -->
                <Expander x:Name="expEdit" Header="Sửa Metadata" FontSize="11" Foreground="#CCC"
                          Margin="6,4,6,8" IsExpanded="False">
                    <StackPanel Margin="2,6,2,2">
                        <TextBlock Text="Description" FontSize="10" Foreground="#888" Margin="0,2,0,2"/>
                        <TextBox x:Name="txtDescription" Background="#2A2A2A" Foreground="#DDD" BorderThickness="0" Padding="4,2" Margin="0,0,0,6"/>
                        <TextBlock Text="Artist" FontSize="10" Foreground="#888" Margin="0,2,0,2"/>
                        <TextBox x:Name="txtArtist" Background="#2A2A2A" Foreground="#DDD" BorderThickness="0" Padding="4,2" Margin="0,0,0,6"/>
                        <TextBlock Text="Copyright" FontSize="10" Foreground="#888" Margin="0,2,0,2"/>
                        <TextBox x:Name="txtCopyright" Background="#2A2A2A" Foreground="#DDD" BorderThickness="0" Padding="4,2" Margin="0,0,0,6"/>
                        <TextBlock Text="Software" FontSize="10" Foreground="#888" Margin="0,2,0,2"/>
                        <TextBox x:Name="txtSoftware" Background="#2A2A2A" Foreground="#DDD" BorderThickness="0" Padding="4,2" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                <TextBlock Text="Make" FontSize="10" Foreground="#888" Margin="0,2,0,2"/>
                                <TextBox x:Name="txtMake" Background="#2A2A2A" Foreground="#DDD" BorderThickness="0" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                <TextBlock Text="Model" FontSize="10" Foreground="#888" Margin="0,2,0,2"/>
                                <TextBox x:Name="txtModel" Background="#2A2A2A" Foreground="#DDD" BorderThickness="0" Padding="4,2"/>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="btnSaveMeta" Content="Lưu Metadata vào ảnh" Height="30" Margin="0,8,0,0"
                                Background="#1E6E43" Foreground="White" BorderThickness="0" Cursor="Hand"
                                Click="BtnSaveMeta_Click" IsEnabled="False"/>
                        <TextBlock Text="Ghi đè trực tiếp file gốc." FontSize="9" Foreground="#666" Margin="0,4,0,0"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
