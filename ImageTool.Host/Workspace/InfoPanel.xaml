<UserControl x:Class="ImageTool.Host.Workspace.InfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanelAltBrush}" Padding="10,8">
            <TextBlock Text="INFO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
            <StackPanel>
                <!-- Histogram -->
                <Border Background="#0F0F0F" Margin="6" Height="120">
                    <Grid>
                        <Image x:Name="imgHistogram" Stretch="Fill"/>
                        <TextBlock x:Name="txtHistEmpty" Text="(histogram)" Foreground="#444" FontSize="10"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Dòng tóm tắt thông số chụp -->
                <TextBlock x:Name="txtCaptureSummary" Margin="10,0,10,4" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed"/>

                <!-- Bảng màu chủ đạo (K-Means) -->
                <Border Background="{DynamicResource BgPanelAltBrush}" Padding="10,4" Margin="0,2,0,0">
                    <TextBlock Text="MÀU CHỦ ĐẠO" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <ItemsControl x:Name="icColors" Margin="6,4,6,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" CornerRadius="3" Cursor="Hand" ToolTip="Click để copy mã màu"
                                    MouseLeftButtonUp="ColorSwatch_Click" Tag="{Binding Hex}">
                                <StackPanel>
                                    <Border Width="42" Height="30" CornerRadius="3" Background="{Binding Brush}"/>
                                    <TextBlock Text="{Binding Hex}" FontSize="8" Foreground="#AAA" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding PercentText}" FontSize="8" Foreground="#88C0D0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Gợi ý màu (color theory) -->
                <TextBlock x:Name="txtContrastAdvice" Margin="10,0,10,2" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
                <ItemsControl x:Name="icSuggest" Margin="6,0,6,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" CornerRadius="3" Cursor="Hand" ToolTip="Màu gợi ý — click để copy"
                                    MouseLeftButtonUp="ColorSwatch_Click" Tag="{Binding Hex}">
                                <StackPanel>
                                    <Border Width="36" Height="22" CornerRadius="3" Background="{Binding Brush}"/>
                                    <TextBlock Text="{Binding Role}" FontSize="8" Foreground="#AAA" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- EXIF header + map -->
                <Border Background="{DynamicResource BgPanelAltBrush}" Padding="10,4">
                    <DockPanel>
                        <Button x:Name="btnMap" DockPanel.Dock="Right" Content="🗺 Bản đồ" Visibility="Collapsed"
                                Padding="6,1" FontSize="10" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource AccentBrush}"
                                BorderThickness="0" Cursor="Hand" Click="BtnMap_Click"
                                ToolTip="Mở vị trí GPS trên Google Maps"/>
                        <TextBlock Text="EXIF" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- KEYWORDS / TAGS (D6.4) -->
                <Border Background="{DynamicResource BgPanelAltBrush}" Padding="10,4">
                    <TextBlock Text="KEYWORDS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <StackPanel Margin="6,4,6,6">
                    <ItemsControl x:Name="icKeywords">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2" Padding="6,1" CornerRadius="9" Background="#33405A">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Leaf}" Foreground="#DDE" FontSize="10"
                                                   VerticalAlignment="Center" ToolTip="{Binding Full}"/>
                                        <Button Content="✕" Tag="{Binding Full}" Click="RemoveKeyword_Click"
                                                Margin="4,0,0,0" Padding="0" Width="14" Height="14" FontSize="9"
                                                Background="Transparent" Foreground="#9AB" BorderThickness="0"
                                                Cursor="Hand" ToolTip="Gỡ keyword"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="txtNoKeywords" Text="(chưa có keyword)" FontSize="10" Foreground="{DynamicResource TextDimBrush}" Margin="2,2,0,0"/>

                    <DockPanel Margin="0,6,0,0">
                        <Button x:Name="btnAddKeyword" DockPanel.Dock="Right" Content="+ Thêm" Padding="6,2"
                                Margin="4,0,0,0" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                                Cursor="Hand" Click="AddKeyword_Click"/>
                        <TextBox x:Name="txtKeywordInput" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                                 Padding="4,3" KeyDown="KeywordInput_KeyDown"
                                 ToolTip="Nhập keyword (phân cấp bằng /, vd Animal/Dog). Enter để thêm."/>
                    </DockPanel>
                    <Button x:Name="btnAutoTag" Content="✨ Auto-tag từ EXIF" Padding="6,2" Margin="0,4,0,0"
                            HorizontalAlignment="Left" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderThickness="0" Cursor="Hand" Click="AutoTagExif_Click"
                            ToolTip="Tự thêm keyword từ metadata: máy ảnh, ống kính, dải ISO, tiêu cự, năm/tháng chụp."/>

                    <TextBlock Text="Gợi ý" FontSize="9" Foreground="{DynamicResource TextDimBrush}" Margin="2,6,0,2"/>
                    <ItemsControl x:Name="icKeywordSuggest">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Leaf}" Tag="{Binding Full}" ToolTip="{Binding Full}"
                                        Click="SuggestKeyword_Click" Margin="2" Padding="6,1" FontSize="10"
                                        Background="#262B22" Foreground="#BDC" BorderThickness="0" Cursor="Hand"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ItemsControl x:Name="icExif" Margin="6,4,6,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Sửa metadata (gộp từ MetaEditor) -->
                <Expander x:Name="expEdit" Header="Sửa Metadata" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                          Margin="6,4,6,8" IsExpanded="False">
                    <StackPanel Margin="2,6,2,2">
                        <TextBlock Text="Description" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                        <TextBox x:Name="txtDescription" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2" Margin="0,0,0,6"/>
                        <TextBlock Text="Artist" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                        <TextBox x:Name="txtArtist" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2" Margin="0,0,0,6"/>
                        <TextBlock Text="Copyright" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                        <TextBox x:Name="txtCopyright" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2" Margin="0,0,0,6"/>
                        <TextBlock Text="Software" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                        <TextBox x:Name="txtSoftware" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                <TextBlock Text="Make" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                                <TextBox x:Name="txtMake" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                <TextBlock Text="Model" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                                <TextBox x:Name="txtModel" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2"/>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="btnSaveMeta" Content="Lưu Metadata vào ảnh" Height="30" Margin="0,8,0,0"
                                Background="{DynamicResource SuccessBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"
                                Click="BtnSaveMeta_Click" IsEnabled="False"/>
                        <TextBlock Text="Ghi đè trực tiếp file gốc." FontSize="9" Foreground="{DynamicResource TextDimBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
