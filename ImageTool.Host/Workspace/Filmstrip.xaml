<UserControl x:Class="ImageTool.Host.Workspace.Filmstrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBaseBrush}" Height="128">
    <Grid>
        <ScrollViewer x:Name="scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="icStrip">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" IsItemsHost="True" Margin="4,0"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="100" Height="112" Margin="3" Background="{DynamicResource BgPanelAltBrush}"
                                BorderThickness="2" CornerRadius="6" Cursor="Hand"
                                MouseLeftButtonUp="StripItem_MouseLeftButtonUp"
                                MouseRightButtonUp="StripItem_MouseRightButtonUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush_}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentWarmBrush}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Thumbnail image and overlays -->
                                <Grid Grid.Row="0">
                                    <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="2"/>
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                            Background="{Binding LabelBrush}"/>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                            Background="{DynamicResource EditedBadgeBrush}" CornerRadius="2" Padding="2,0"
                                            Visibility="{Binding IsEdited, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Đã chỉnh sửa">
                                        <TextBlock Text="✎" Foreground="#000" FontSize="8" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="{Binding RatingDisplay}" Foreground="{DynamicResource RatingBrush}" FontSize="9"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2"/>
                                </Grid>
                                
                                <!-- File name text -->
                                <Border Grid.Row="1" Background="{DynamicResource BgPanelBrush}" Padding="4,2">
                                    <TextBlock Text="{Binding FileName}" FontSize="9" 
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="90"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
