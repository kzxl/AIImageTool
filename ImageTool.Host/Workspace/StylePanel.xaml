<UserControl x:Class="ImageTool.Host.Workspace.StylePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1A1A1A" Foreground="#DDD">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#252526" Padding="10,8">
            <DockPanel>
                <TextBlock Text="STYLES" FontSize="11" FontWeight="SemiBold" Foreground="#888" VerticalAlignment="Center"/>
                <Button x:Name="btnSave" DockPanel.Dock="Right" Content="+ Save" Height="22" Padding="8,2"
                        Background="#2D2D30" Foreground="#DDD" BorderThickness="0" Cursor="Hand"
                        Click="BtnSave_Click" ToolTip="Lưu history hiện tại của ảnh đang chọn thành Style"/>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icStyles">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="6,4" Margin="0,1" Background="#202020" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Apply" Padding="6,2" Margin="2,0" FontSize="10"
                                            Background="#1E6E43" Foreground="White" BorderThickness="0" Cursor="Hand"
                                            Tag="{Binding Id}" Click="BtnApply_Click"/>
                                    <Button Content="✕" Width="22" Height="22" Margin="2,0"
                                            Background="Transparent" Foreground="#888" BorderThickness="0" Cursor="Hand"
                                            Tag="{Binding Id}" Click="BtnDelete_Click" ToolTip="Xóa"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="#DDD" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding OpsSummary}" Foreground="#666" FontSize="10"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
