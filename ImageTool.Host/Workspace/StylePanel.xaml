<UserControl x:Class="ImageTool.Host.Workspace.StylePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanelAltBrush}" Padding="10,8">
            <DockPanel>
                <TextBlock Text="STYLES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Button x:Name="btnSave" DockPanel.Dock="Right" Content="+ Save" Height="22" Padding="8,2"
                        Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand"
                        Click="BtnSave_Click" ToolTip="Lưu history hiện tại của ảnh đang chọn thành Style"/>
                <Button x:Name="btnImportXmp" DockPanel.Dock="Right" Content="Import XMP" Height="22" Padding="8,2" Margin="0,0,4,0"
                        Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand"
                        Click="BtnImportXmp_Click" ToolTip="Nhập preset Lightroom (.xmp) thành Style"/>
                <CheckBox x:Name="chkAppend" DockPanel.Dock="Right" Content="Append" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"
                          VerticalAlignment="Center" Margin="0,0,8,0" IsChecked="True"
                          ToolTip="Append: giữ chỉnh sửa hiện có, chỉ thay/thêm module của style. Bỏ chọn = thay toàn bộ."/>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icStyles">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="6,4" Margin="0,1" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderBrush_}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Apply" Padding="6,2" Margin="2,0" FontSize="10"
                                            Background="{DynamicResource SuccessBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"
                                            Tag="{Binding Id}" Click="BtnApply_Click"/>
                                    <Button Content="✕" Width="22" Height="22" Margin="2,0"
                                            Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand"
                                            Tag="{Binding Id}" Click="BtnDelete_Click" ToolTip="Xóa"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding OpsSummary}" Foreground="{DynamicResource TextDimBrush}" FontSize="10"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
