<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ImageTool.Core\ImageTool.Core.csproj" />
    <ProjectReference Include="..\ImageTool.Shared\ImageTool.Shared.csproj" />
    <ProjectReference Include="..\ImageTool.Imaging\ImageTool.Imaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!--
    Native RAW (LibRaw) TUỲ CHỌN: bỏ libraw.dll (+ phụ thuộc) vào thư mục "native/" cạnh solution
    để tự copy vào output. Không có file -> bỏ qua, app dùng JPEG-preview fallback. Không bắt buộc build.
  -->
  <ItemGroup>
    <NativeRawDll Include="$(MSBuildProjectDirectory)\..\native\*.dll" />
  </ItemGroup>
  <Target Name="CopyNativeRaw" AfterTargets="Build" Condition="'@(NativeRawDll)' != ''">
    <Copy SourceFiles="@(NativeRawDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="LibRaw native: đã copy @(NativeRawDll->'%(Filename)%(Extension)', ', ') vào output." />
  </Target>

</Project>
