<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ImageTool.Core\ImageTool.Core.csproj" />
    <ProjectReference Include="..\ImageTool.Shared\ImageTool.Shared.csproj" />
    <ProjectReference Include="..\ImageTool.Imaging\ImageTool.Imaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Thương hiệu hiển thị (exe metadata + About). Tên assembly giữ ImageTool.Host để không
         ảnh hưởng nạp plugin / đường dẫn. -->
    <Product>Aurora Studio</Product>
    <AssemblyTitle>Aurora Studio</AssemblyTitle>
    <Description>Aurora Studio — trình chỉnh sửa ảnh phi phá hủy (linear-light) + AI.</Description>
    <Company>Aurora Studio</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!--
    Native RAW (LibRaw) TUỲ CHỌN: bỏ libraw.dll (+ phụ thuộc) vào thư mục "native/" cạnh solution
    để tự copy vào output. Không có file -> bỏ qua, app dùng JPEG-preview fallback. Không bắt buộc build.
  -->
  <ItemGroup>
    <NativeRawDll Include="$(MSBuildProjectDirectory)\..\native\*.dll" />
  </ItemGroup>
  <Target Name="CopyNativeRaw" AfterTargets="Build" Condition="'@(NativeRawDll)' != ''">
    <Copy SourceFiles="@(NativeRawDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="LibRaw native: đã copy @(NativeRawDll->'%(Filename)%(Extension)', ', ') vào output." />
  </Target>

  <!--
    Lensfun DB TUỲ CHỌN (5.3): bỏ các file XML lensfun vào "lensfun/" cạnh solution để bật hiệu chỉnh
    ống kính tự động. Không có file -> bỏ qua, dùng chỉnh tay. Copy giữ cấu trúc thư mục con.
  -->
  <ItemGroup>
    <LensfunXml Include="$(MSBuildProjectDirectory)\..\lensfun\**\*.xml" />
  </ItemGroup>
  <Target Name="CopyLensfun" AfterTargets="Build" Condition="'@(LensfunXml)' != ''">
    <Copy SourceFiles="@(LensfunXml)" DestinationFolder="$(OutDir)lensfun\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Lensfun: đã copy @(LensfunXml->Count()) file XML vào output\lensfun." />
  </Target>

</Project>
