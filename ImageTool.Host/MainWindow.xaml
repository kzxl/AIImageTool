<Window x:Class="ImageTool.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ws="clr-namespace:ImageTool.Host.Workspace"
        Title="Aurora Studio" Height="820" Width="1480"
        Background="{DynamicResource BgBaseBrush}"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">
    <Border Background="{DynamicResource BgBaseBrush}" BorderBrush="{DynamicResource BorderBrush_}" BorderThickness="1" CornerRadius="6">
    <Border.Effect>
        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
    </Border.Effect>
    <Grid>
    <DockPanel>
        <!-- ========== CUSTOM TITLE BAR ========== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanelBrush}" Height="36"
                BorderBrush="{DynamicResource BorderBrush_}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                MouseMove="TitleBar_MouseMove">
            <DockPanel LastChildFill="True" Margin="10,0">
                <!-- App title (drag region) -->
                <TextBlock Text="✦ Aurora Studio" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <!-- Window controls (right) -->
                <Button x:Name="btnClose" DockPanel.Dock="Right" Content="✕" Width="36" Height="28"
                        Padding="0" Click="BtnClose_Click" ToolTip="Đóng"
                        Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                        BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                <Button x:Name="btnMaximize" DockPanel.Dock="Right" Content="☐" Width="36" Height="28"
                        Padding="0" Click="BtnMaximize_Click" ToolTip="Phóng to/Thu nhỏ"
                        Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                        BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                <Button x:Name="btnMinimize" DockPanel.Dock="Right" Content="─" Width="36" Height="28"
                        Padding="0" Click="BtnMinimize_Click" ToolTip="Thu nhỏ"
                        Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                        BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                <!-- Theme toggle -->
                <Button x:Name="btnTheme" DockPanel.Dock="Right" Content="◐" Width="30" Height="28"
                        Padding="6,0" VerticalAlignment="Center" Margin="0,0,8,0" Click="BtnTheme_Click"
                        ToolTip="Đổi giao diện Sáng/Tối"/>
                <!-- Left: Open / Recent -->
                <Button x:Name="btnOpenFolder" DockPanel.Dock="Left" Content="📁  Open" Padding="14,4"
                        VerticalAlignment="Center" Click="BtnOpenFolder_Click"
                        ToolTip="Mở thư mục ảnh để duyệt"/>
                <Button x:Name="btnRecent" DockPanel.Dock="Left" Content="▾" Width="28" Padding="6,6"
                        Margin="2,0,4,0" VerticalAlignment="Center" Click="BtnRecent_Click"
                        ToolTip="Recent folders"/>
                <Button x:Name="btnImport" DockPanel.Dock="Left" Content="⬇  Import" Padding="14,6"
                        VerticalAlignment="Center" Margin="4,0,12,0" Click="BtnImport_Click"
                        ToolTip="Import photos into catalog"/>
                <Button x:Name="btnMore" DockPanel.Dock="Left" Content="⋯  Tools" Padding="12,6"
                        VerticalAlignment="Center" Margin="0,0,12,0" Click="BtnMore_Click"
                        ToolTip="Công cụ trên ảnh đang chọn: Merge HDR, Focus Stack, Batch Rename"/>

                <!-- Right: Pop Out + Mode Switcher + Quick Filter -->
                <Button x:Name="btnPopOutTools" DockPanel.Dock="Right" Content="⇱  Pop Out Tools"
                        Padding="10,6" VerticalAlignment="Center" Margin="6,0,0,0"
                        Click="BtnPopOutTools_Click"
                        ToolTip="Tách panel Tools sang cửa sổ riêng (multi-monitor)"/>

                <!-- Mode switcher -->
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                        BorderBrush="{DynamicResource BorderBrush_}" BorderThickness="1" CornerRadius="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="rbModeSingle" GroupName="Mode" Content="◰ Single" IsChecked="True"
                                     Style="{DynamicResource ModeToggleStyle}" Click="ModeBtn_Click" Tag="Single"
                                     ToolTip="E"/>
                        <RadioButton x:Name="rbModeGrid" GroupName="Mode" Content="▦ Grid"
                                     Style="{DynamicResource ModeToggleStyle}" Click="ModeBtn_Click" Tag="Grid"
                                     ToolTip="G"/>
                        <RadioButton x:Name="rbModeCull" GroupName="Mode" Content="❐ Cull"
                                     Style="{DynamicResource ModeToggleStyle}" Click="ModeBtn_Click" Tag="Cull"
                                     ToolTip="C"/>
                        <RadioButton x:Name="rbModeFull" GroupName="Mode" Content="⛶ Full"
                                     Style="{DynamicResource ModeToggleStyle}" Click="ModeBtn_Click" Tag="Full"
                                     ToolTip="F"/>
                    </StackPanel>
                </Border>

                <!-- Quick filter: rating + labels -->
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                        BorderBrush="{DynamicResource BorderBrush_}" BorderThickness="1" CornerRadius="3"
                        Padding="6,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="★≥" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="cmbQuickRating" Width="46" Height="22" SelectedIndex="0"
                                  SelectionChanged="CmbQuickRating_SelectionChanged"
                                  ToolTip="Lọc: chỉ hiện ảnh có rating ≥ giá trị này">
                            <ComboBoxItem Content="—"/>
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                        </ComboBox>
                        <Border Width="1" Background="{DynamicResource BorderBrush_}" Margin="8,2"/>
                        <Button Tag="None"   Width="16" Height="16" Background="Transparent"
                                BorderBrush="{DynamicResource BorderHoverBrush}" BorderThickness="1" Margin="2,0" Click="QuickLabel_Click"
                                ToolTip="Tất cả label"/>
                        <Button Tag="Red"    Width="16" Height="16" Background="Red"          BorderThickness="0" Margin="2,0" Click="QuickLabel_Click" ToolTip="Lọc nhãn Đỏ"/>
                        <Button Tag="Yellow" Width="16" Height="16" Background="Gold"         BorderThickness="0" Margin="2,0" Click="QuickLabel_Click" ToolTip="Lọc nhãn Vàng"/>
                        <Button Tag="Green"  Width="16" Height="16" Background="LimeGreen"    BorderThickness="0" Margin="2,0" Click="QuickLabel_Click" ToolTip="Lọc nhãn Lục"/>
                        <Button Tag="Blue"   Width="16" Height="16" Background="DodgerBlue"   BorderThickness="0" Margin="2,0" Click="QuickLabel_Click" ToolTip="Lọc nhãn Lam"/>
                        <Button Tag="Purple" Width="16" Height="16" Background="MediumPurple" BorderThickness="0" Margin="2,0" Click="QuickLabel_Click" ToolTip="Lọc nhãn Tím"/>
                        <Border Width="1" Background="{DynamicResource BorderBrush_}" Margin="8,2"/>
                        <Button x:Name="btnFilterPick" Content="✓" Width="22" Height="20" Margin="2,0" Padding="0"
                                Click="FilterPick_Click" ToolTip="Chỉ hiện ảnh Pick (bấm lại để bỏ)"/>
                        <Button x:Name="btnFilterReject" Content="✗" Width="22" Height="20" Margin="2,0" Padding="0"
                                Click="FilterReject_Click" ToolTip="Chỉ hiện ảnh Reject (bấm lại để bỏ)"/>
                        <Button x:Name="btnHideReject" Content="⊘" Width="22" Height="20" Margin="2,0" Padding="0"
                                Click="HideReject_Click" ToolTip="Ẩn ảnh đã Reject (luồng cull)"/>
                    </StackPanel>
                </Border>

                <!-- Center: Breadcrumb -->
                <ItemsControl x:Name="breadcrumb" VerticalAlignment="Center" Margin="8,0,8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ========== STATUS BAR (bottom) ========== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgPanelBrush}" Height="22"
                BorderBrush="{DynamicResource BorderBrush_}" BorderThickness="0,1,0,0">
            <DockPanel Margin="10,0">
                <TextBlock x:Name="txtStatus" Text="Ready"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBlock x:Name="txtSelInfo" Text=""
                           Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                           VerticalAlignment="Center" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <!-- ========== MAIN AREA ========== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colLeft" Width="280" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition x:Name="colRight" Width="380" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Navigation, History, Layers -->
            <Grid Grid.Column="0" Background="{DynamicResource BgPanelBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0">
                        <Expander Header="Folder" IsExpanded="True" Margin="0,0,0,4">
                            <ws:WorkspaceBrowser x:Name="browser" Height="260"/>
                        </Expander>
                        <Expander Header="History" IsExpanded="True" Margin="0,0,0,4">
                            <ws:HistoryPanel x:Name="historyPanel" MaxHeight="300"/>
                        </Expander>
                        <Expander Header="Presets" IsExpanded="True" Margin="0,0,0,4">
                            <ws:StylePanel x:Name="stylePanel" MaxHeight="300"/>
                        </Expander>
                        <Expander Header="Active Layers" IsExpanded="True" Margin="0,0,0,4">
                            <StackPanel x:Name="panelActiveLayers" Margin="8,4"/>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BgBaseBrush}"/>

            <!-- CENTER -->
            <DockPanel Grid.Column="2">
                <ws:Filmstrip x:Name="filmstrip" DockPanel.Dock="Bottom"/>
                <ws:CenterPreview x:Name="centerView"/>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BgBaseBrush}"/>

            <!-- RIGHT: Tabs -->
            <Grid Grid.Column="4" x:Name="toolsHost" Background="{DynamicResource BgPanelBrush}">
                <TabControl x:Name="rightTabs" Background="Transparent" TabStripPlacement="Right"
                            BorderBrush="{DynamicResource BorderBrush_}" BorderThickness="0">
                    <TabItem Header="Develop">
                        <ws:DevelopPanel x:Name="developPanel"/>
                    </TabItem>
                    <TabItem Header="Info">
                        <ws:InfoPanel x:Name="infoPanel"/>
                    </TabItem>
                    <TabItem Header="Batch">
                        <ws:BatchQueuePanel x:Name="batchPanel"/>
                    </TabItem>
                    <TabItem Header="Export">
                        <ws:ExportPanel x:Name="exportPanel"/>
                    </TabItem>
                    <TabItem Header="Tools">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ListBox x:Name="lstPlugins" Grid.Column="0" Width="60"
                                     Background="{DynamicResource BgBaseBrush}"
                                     BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BorderBrush_}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="LstPlugins_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="0,10">
                                                        <ContentPresenter HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgPanelAltBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" FontSize="20" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding ShortName}" FontSize="9" HorizontalAlignment="Center"
                                                       Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="56"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ContentControl x:Name="contentPresenter" Grid.Column="1"
                                            Background="{DynamicResource BgPanelBrush}"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>

    <!-- Toast notification (overlay) -->
    <Border x:Name="toastBorder" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="0,0,0,40" Background="{DynamicResource BgPanelAltBrush}" CornerRadius="6" Padding="16,10"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
            Visibility="Collapsed" Panel.ZIndex="100">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>
        <TextBlock x:Name="txtToast" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
    </Border>

    <!-- Drag & Drop overlay -->
    <Border x:Name="dropOverlay" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="150"
            AllowDrop="True">
        <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource AccentBrush}" 
                BorderThickness="2" CornerRadius="12" Padding="40"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="⬇" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Thả ảnh hoặc thư mục vào đây" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Hỗ trợ: JPG, PNG, TIFF, WebP, RAW, PSD..." FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Border>

    <!-- Shortcut overlay (F1) -->
    <Border x:Name="shortcutOverlay" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="200"
            MouseLeftButtonDown="ShortcutOverlay_Click">
        <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderBrush_}" BorderThickness="1"
                CornerRadius="8" Padding="24,18" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Phím tắt" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ĐIỀU HƯỚNG &amp; XEM" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="← →   Ảnh trước / kế tiếp" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,1"/>
                        <TextBlock Text="E / G / C / F   Single / Grid / Cull / Full" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,1"/>
                        <TextBlock Text="Z   Zoom 100% / fit     + / −   Zoom" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,1"/>
                        <TextBlock Text="Space   Giữ để kéo (pan)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,1"/>
                        <TextBlock Text="Y   So sánh   \   Giữ xem ảnh gốc" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,1"/>
                        <TextBlock Text="J   Cảnh báo clip   K   Focus peaking" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,1"/>
                        <TextBlock Text="CẮT / HÌNH HỌC" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                        <TextBlock Text="R   Bật/tắt cắt   O   Đổi lưới guide" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,1"/>
                        <TextBlock Text="Enter   Áp cắt   Esc   Huỷ cắt" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,1"/>
                        <TextBlock Text="[ / ]   Xoay trái / phải" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ĐÁNH GIÁ / CỜ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="0–5   Rating sao" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,1"/>
                        <TextBlock Text="P / X / U   Pick / Reject / Bỏ cờ" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,1"/>
                        <TextBlock Text="6 / 7 / 8 / 9   Nhãn màu" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,1"/>
                        <TextBlock Text="CHỈNH SỬA" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                        <TextBlock Text="D   Develop   M   Masking" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,1"/>
                        <TextBlock Text="Ctrl+Z / Ctrl+Y   Undo / Redo" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,1"/>
                        <TextBlock Text="Ctrl+Shift+C / V   Copy / Paste chỉnh" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,1"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Nhấn F1, ? hoặc Esc để đóng" FontSize="10" Foreground="{DynamicResource TextDimBrush}"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </Border>
    </Grid>
    </Border>
</Window>
