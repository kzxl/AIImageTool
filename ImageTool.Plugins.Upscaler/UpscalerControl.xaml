<UserControl x:Class="ImageTool.Plugins.Upscaler.UpscalerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E" Foreground="#DDD">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
            <TextBlock Text="AI Upscaler" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBlock x:Name="txtActiveImage" Text="(chưa chọn ảnh)" Foreground="#888" FontSize="11"
                       Margin="0,0,0,12" TextTrimming="CharacterEllipsis"
                       ToolTip="Ảnh đang mở ở khung xem trung tâm"/>

            <TextBlock Text="Thiết bị" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="cmbDevice" Margin="0,0,0,8" SelectedIndex="0"
                      ToolTip="Thiết bị thực thi (GPU/CPU)" DisplayMemberPath="Name"/>

            <TextBlock Text="Hiệu năng" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="cmbPerformance" Margin="0,0,0,8" SelectedIndex="0"
                      ToolTip="Mức độ hiệu năng">
                <ComboBoxItem Content="An toàn (giữ CPU/RAM thấp)" Tag="Safe"/>
                <ComboBoxItem Content="Bung lụa (ép tối đa CPU/RAM)" Tag="Unleashed"/>
            </ComboBox>

            <TextBlock Text="Model" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="cmbModel" Margin="0,0,0,8" SelectedIndex="0"
                      SelectionChanged="CmbModel_SelectionChanged">
                <ComboBoxItem Content="Fast Resize (Lanczos)"/>
                <ComboBoxItem Content="UltraSharp V2 (Chất lượng)" Tag="4x-UltraSharpV2_fp32_op17.onnx"/>
                <ComboBoxItem Content="RealESRGAN-x4plus (Tốc độ)" Tag="real_esrgan_x4plus.onnx"/>
                <ComboBoxItem Content="FSRCNN (Siêu nhẹ)" Tag="fsrcnn_x4.onnx"/>
                <ComboBoxItem Content="AuraSR (Generative API)"/>
            </ComboBox>

            <TextBlock Text="Tỷ lệ / Mục tiêu" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="cmbScale" Margin="0,0,0,12" SelectedIndex="2"/>

            <Border Background="#252526" Padding="8" CornerRadius="3" Margin="0,4,0,8">
                <StackPanel>
                    <TextBlock x:Name="txtStatus" Text="Sẵn sàng" Foreground="#AAA" FontSize="11"/>
                    <TextBlock x:Name="txtExecMode" Text="" Foreground="#55C1E7" FontStyle="Italic" FontSize="10" Margin="0,3,0,0"/>
                    <ProgressBar x:Name="pbProgress" Height="6" Minimum="0" Maximum="100" Value="0"
                                 Visibility="Hidden" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Button x:Name="btnProcess" Content="Upscale ảnh đang chọn" Height="34"
                    Background="#007ACC" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Click="BtnProcess_Click" IsEnabled="False"/>

            <Button x:Name="btnBatch" Content="Batch (selection)" Height="30" Margin="0,8,0,0"
                    Background="#7A4FBF" Foreground="White" BorderThickness="0"
                    Click="BtnBatch_Click" IsEnabled="False"
                    ToolTip="Chạy hàng loạt trên các ảnh đã chọn ở Workspace"/>

            <TextBlock Text="Ảnh kết quả sẽ hiển thị tại Center Preview với splitter so sánh trước/sau."
                       Foreground="#666" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
