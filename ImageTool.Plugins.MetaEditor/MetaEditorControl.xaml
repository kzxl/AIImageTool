<UserControl x:Class="ImageTool.Plugins.MetaEditor.MetaEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E" Foreground="White">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Metadata Editor (EXIF)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBlock x:Name="txtActiveImage" Text="(chưa chọn ảnh)" Foreground="#888" FontSize="11"
                       Margin="0,2,0,6" TextTrimming="CharacterEllipsis"
                       ToolTip="Ảnh đang mở ở khung xem trung tâm"/>
            <TextBlock Text="Hỗ trợ sửa: Software, ImageDescription, Make, Model, Artist, Copyright"
                       FontSize="11" Foreground="#888" TextWrapping="Wrap"/>
        </StackPanel>

        <Button x:Name="btnSaveMeta" DockPanel.Dock="Bottom" Content="Lưu Thay Đổi Meta" Height="38"
                Margin="0,12,0,0" Background="#1E6E43" Foreground="White" BorderThickness="0"
                Cursor="Hand" Click="BtnSaveMeta_Click" IsEnabled="False">
            <Button.Resources>
                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
            </Button.Resources>
        </Button>

        <DataGrid x:Name="dgMeta" AutoGenerateColumns="False"
                  CanUserAddRows="False" Background="Transparent" Foreground="#CCC"
                  RowBackground="#333" AlternatingRowBackground="#3A3A3A" BorderThickness="0"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#555" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Thuộc tính" Binding="{Binding Name}" IsReadOnly="True" Width="130"/>
                <DataGridTextColumn Header="Giá trị" Binding="{Binding Value}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
